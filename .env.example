# ============================================================
# RepoMind Configuration
# ============================================================
# Copy this file to .env and uncomment the lines you want to change.
# All settings are optional — sensible defaults are used if not set.
#
# Usage:
#   cp .env.example .env      # Linux/Mac
#   copy .env.example .env     # Windows
# ============================================================

# -----------------------------------------------------------
# Embedding Model (for semantic code search)
# -----------------------------------------------------------
# Used by: repomind index, repomind search, repomind ask
# Must be a sentence-transformers model from Hugging Face.
# Downloaded automatically on first use.
#
# Lightweight (2GB+ RAM):
#   BAAI/bge-small-en-v1.5     — 384-dim, ~35MB, good quality
#   all-MiniLM-L6-v2           — 384-dim, ~90MB, good quality (DEFAULT)
#   all-MiniLM-L12-v2          — 384-dim, ~120MB, better quality
#
# Higher quality (4GB+ RAM):
#   BAAI/bge-base-en-v1.5      — 768-dim, ~130MB, better quality
#   all-mpnet-base-v2          — 768-dim, ~440MB, best quality
#
# REPOMIND_EMBEDDING_MODEL=all-MiniLM-L6-v2

# -----------------------------------------------------------
# LLM Model (for AI Q&A via Ollama)
# -----------------------------------------------------------
# Used by: repomind ask
# Must be pulled first: ollama pull <model_name>
#
# 4GB+ RAM (lightweight):
#   qwen2.5:1.5b               — 1.5B params, ~1GB, basic
#   phi3:3.8b                  — 3.8B params, ~2.2GB, good
#   llama3.2:3b                — 3B params, ~2GB, good (DEFAULT)
#
# 8GB+ RAM (medium):
#   mistral:7b                 — 7B params, ~4.1GB, better
#   deepseek-coder:6.7b        — 6.7B params, ~3.8GB, best for code
#   llama3.1:8b                — 8B params, ~4.7GB, excellent
#
# 16GB+ RAM (high-end):
#   codellama:34b              — 34B params, ~19GB, best overall
#   llama3:70b                 — 70B params, ~40GB, premium
#
# REPOMIND_LLM_MODEL=llama3.2

# -----------------------------------------------------------
# Ollama Host URL
# -----------------------------------------------------------
# Change if Ollama is running on a different machine or port.
# Default: http://localhost:11434
#
# REPOMIND_OLLAMA_HOST=http://localhost:11434

# -----------------------------------------------------------
# Index Directory (for FAISS vector store)
# -----------------------------------------------------------
# Where the FAISS index and chunk metadata are saved.
# Default: .repomind/indexes
#
# REPOMIND_INDEX_DIR=.repomind/indexes

# -----------------------------------------------------------
# Chunking Settings
# -----------------------------------------------------------
# Maximum lines per code chunk (for indexing).
# Lower = more granular chunks, higher = more context per chunk.
# Default: 100
#
# REPOMIND_MAX_CHUNK_LINES=100

# -----------------------------------------------------------
# Search Settings
# -----------------------------------------------------------
# Default number of search results returned.
# Default: 5
#
# REPOMIND_TOP_K=5

# -----------------------------------------------------------
# Device for Embeddings
# -----------------------------------------------------------
# Set to "cuda" for GPU acceleration (requires CUDA-capable GPU).
# Set to "cpu" for CPU-only mode.
# Default: auto-detect
#
# REPOMIND_DEVICE=cpu